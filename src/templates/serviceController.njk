{% if genType === "ts" %}
type OpenAPIParameter = {
  name: string;
  inputName?: string;
  in?: string;
  style?: string;
  explode?: boolean;
  allowReserved?: boolean;
  contentType?: string;
};
{% if hasFormBody %}
type OpenAPIEncoding = Record<string, Omit<OpenAPIParameter, 'name'> & { headers?: Record<string, unknown> }>;
{% endif %}
{% endif %}
function encodeParameter(value{% if genType === "ts" %}: unknown{% endif %}, allowReserved = false) {
  const encoded = encodeURIComponent(String(value)).replace(/[!'()*]/g, (char) =>
    '%' + char.charCodeAt(0).toString(16).toUpperCase(),
  );
  return allowReserved
    ? encoded.replace(/%(?:3A|2F|3F|23|5B|5D|40|21|24|26|27|28|29|2A|2B|2C|3B|3D)/gi, decodeURIComponent)
    : encoded;
}

function parameterPairs(
  name{% if genType === "ts" %}: string{% endif %},
  value{% if genType === "ts" %}: unknown{% endif %},
  definition{% if genType === "ts" %}: OpenAPIParameter{% endif %},
  encoded = true,
){% if genType === "ts" %}: [string, string][]{% endif %} {
  const encode = (item{% if genType === "ts" %}: unknown{% endif %}) => encoded ? encodeParameter(item, definition.allowReserved) : String(item);
  const key = (item{% if genType === "ts" %}: string{% endif %}) => encoded ? encodeParameter(item) : item;
  if (definition.contentType) {
    return [[key(name), encode(/(?:\/|\+)json(?:\s*;|$)/i.test(definition.contentType) ? JSON.stringify(value) : String(value))]];
  }
  const style = definition.style || 'form';
  const explode = definition.explode === undefined ? style === 'form' : definition.explode;
  if (style === 'deepObject' && value !== null && typeof value === 'object') {
    const pairs{% if genType === "ts" %}: [string, string][]{% endif %} = [];
    const append = (prefix{% if genType === "ts" %}: string{% endif %}, item{% if genType === "ts" %}: unknown{% endif %}) => {
      if (item === undefined || item === null) return;
      if (typeof item === 'object') {
        const record = item{% if genType === "ts" %} as Record<string, unknown>{% endif %};
        Object.keys(record).forEach((child) => append(`${prefix}[${key(child)}]`, record[child]));
      } else {
        pairs.push([prefix, encode(item)]);
      }
    };
    append(key(name), value);
    return pairs;
  }
  const separator = style === 'spaceDelimited' ? (encoded ? '%20' : ' ') : style === 'pipeDelimited' ? '|' : ',';
  if (Array.isArray(value)) {
    return explode ? value.map((item){% if genType === "ts" %}: [string, string]{% endif %} => [key(name), encode(item)]) : [[key(name), value.map(encode).join(separator)]];
  }
  if (value !== null && typeof value === 'object') {
    const record = value{% if genType === "ts" %} as Record<string, unknown>{% endif %};
    const keys = Object.keys(record);
    return explode
      ? keys.map((item){% if genType === "ts" %}: [string, string]{% endif %} => [key(item), encode(record[item])])
      : [[key(name), keys.map((item) => `${key(item)}${separator}${encode(record[item])}`).join(separator)]];
  }
  return [[key(name), encode(value)]];
}

{% if hasParameters %}
function serializeParameter(
  value{% if genType === "ts" %}: unknown{% endif %},
  definition{% if genType === "ts" %}: OpenAPIParameter{% endif %},
) {
  if (value === undefined || value === null) return '';
  const location = definition.in;
  const style = definition.style || (location === 'path' || location === 'header' ? 'simple' : 'form');
  if (location !== 'path' && location !== 'header') {
    const queryDefinition = location === 'query' ? definition : { ...definition, allowReserved: false };
    return parameterPairs(definition.name, value, queryDefinition).map(([key, item]) => `${key}=${item}`).join(location === 'cookie' ? '; ' : '&');
  }
  const encode = (item{% if genType === "ts" %}: unknown{% endif %}) => location === 'header' ? String(item) : encodeParameter(item);
  if (definition.contentType) {
    return encode(/(?:\/|\+)json(?:\s*;|$)/i.test(definition.contentType) ? JSON.stringify(value) : String(value));
  }
  const name = encode(definition.name);
  const explode = definition.explode === true;
  const separator = style === 'label' && explode ? '.' : ',';
  let result;
  if (Array.isArray(value)) {
    result = value.map(encode).join(style === 'matrix' && explode ? `;${name}=` : separator);
  } else if (typeof value === 'object') {
    const record = value{% if genType === "ts" %} as Record<string, unknown>{% endif %};
    result = Object.keys(record).map((key) => `${encode(key)}${explode ? '=' : ','}${encode(record[key])}`)
      .join(style === 'matrix' && explode ? ';' : separator);
  } else {
    result = encode(value);
  }
  if (style === 'label') return `.${result}`;
  if (style === 'matrix') return `;${explode && typeof value === 'object' && !Array.isArray(value) ? '' : `${name}=`}${result}`;
  return result;
}

function serializeParameters(
  params{% if genType === "ts" %}: Record<string, unknown>{% endif %},
  definitions{% if genType === "ts" %}: OpenAPIParameter[]{% endif %},
) {
  const query{% if genType === "ts" %}: Record<string, unknown>{% endif %} = Object.create(null);
  const headers{% if genType === "ts" %}: Record<string, string>{% endif %} = Object.create(null);
  const search{% if genType === "ts" %}: string[]{% endif %} = [];
  const cookies{% if genType === "ts" %}: string[]{% endif %} = [];
  definitions.forEach((definition) => {
    const value = params[definition.inputName || definition.name];
    if (value === undefined || value === null || definition.in === 'path') return;
    if (definition.in === 'query' && typeof value !== 'object' && definition.style === undefined && definition.explode === undefined && definition.allowReserved === undefined && !definition.contentType) {
      query[definition.name] = value;
      return;
    }
    const serialized = serializeParameter(value, definition);
    if (definition.in === 'query') search.push(serialized);
    if (definition.in === 'header') headers[definition.name] = serialized;
    if (definition.in === 'cookie') cookies.push(serialized);
  });
  if (cookies.length) headers.Cookie = cookies.join('; ');
  return { query, headers, search: search.filter(Boolean).join('&') };
}

function appendQuery(url{% if genType === "ts" %}: string{% endif %}, query{% if genType === "ts" %}: string{% endif %}) {
  if (!query) return url;
  const hashIndex = url.indexOf('#');
  const hash = hashIndex < 0 ? '' : url.slice(hashIndex);
  const base = hashIndex < 0 ? url : url.slice(0, hashIndex);
  return base + (base.includes('?') ? (/[?&]$/.test(base) ? '' : '&') : '?') + query + hash;
}
