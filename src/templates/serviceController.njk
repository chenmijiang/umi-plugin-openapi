  {% endfor -%}
  {% endif -%}
  {% if api.hasFormData or api.body.mediaType === "application/x-www-form-urlencoded" -%}
  const formData = ({% if api.body %}body !== undefined{% else %}false{% endif %}{% for file in api.file %} || {{ file.title | safe }} !== undefined{% endfor %}) ? await serializeFormBody({
    {% if api.body -%}
    ...(body || {}),
    {% endif -%}
    {% for file in api.file -%}
    [{{ file.title | dump | safe }}]: {{ file.title | safe }},
    {% endfor -%}
  }, JSON.parse({{ api.encoding | dump | dump | safe }}), {{ 'false' if api.body.mediaType === "application/x-www-form-urlencoded" else 'true' }}) : undefined;
  {% endif -%}

  return request{{ ("<" + api.response.type + ">") | safe if genType === "ts" }}({% if api.hasParams %}appendQuery({% endif %}`{{ api.path | safe }}`{% if api.hasParams %}, serialized.search){% endif %}, {
