{% if hasFormBody %}

function partContentType(declared{% if genType === "ts" %}: string | undefined{% endif %}, actual{% if genType === "ts" %}: string{% endif %}) {
  if (!declared) return actual;
  const choices = declared.split(',').map((item) => item.trim()).filter(Boolean);
  const actualType = actual.split(';')[0].trim().toLowerCase();
  if (actualType && !actualType.includes('*') && choices.some((choice) => {
    const type = choice.split(';')[0].trim().toLowerCase();
    return type === actualType || type === '*/*' || type === actualType.split('/')[0] + '/*';
  })) return actual;
  const concrete = choices.find((choice) => !choice.split(';')[0].includes('*'));
  if (concrete) return concrete;
  throw new Error(`Cannot select a concrete content type from ${declared} for ${actual || 'an untyped part'}`);
}

async function serializeFormBody(
  body{% if genType === "ts" %}: Record<string, unknown>{% endif %},
  encoding{% if genType === "ts" %}: OpenAPIEncoding{% endif %},
  multipart{% if genType === "ts" %}: boolean{% endif %},
) {
  const form = multipart ? new FormData() : undefined;
  const fields{% if genType === "ts" %}: string[]{% endif %} = [];
  for (const name of Object.keys(body)) {
    let value = body[name];
    if (value === undefined || value === null) continue;
    const definition = Object.prototype.hasOwnProperty.call(encoding, name) ? encoding[name] : {};
    if (!multipart) {
      const contentType = definition.contentType
        ? partContentType(definition.contentType, typeof Blob !== 'undefined' && value instanceof Blob ? value.type : typeof value === 'object' ? 'application/json' : 'text/plain')
        : undefined;
      if (typeof Blob !== 'undefined') {
        if (value instanceof Blob) value = await value.text();
        else if (Array.isArray(value)) value = await Promise.all(value.map((item) => item instanceof Blob ? item.text() : item));
      }
      parameterPairs(name, value, { ...definition, contentType, name }).forEach(([key, item]) => fields.push(`${key}=${item}`));
      continue;
    }
    const append = (key{% if genType === "ts" %}: string{% endif %}, item{% if genType === "ts" %}: unknown{% endif %}) => {
      if (item === undefined || item === null) return;
      if (typeof Blob !== 'undefined' && item instanceof Blob) {
        const contentType = partContentType(definition.contentType, item.type);
        const part = contentType !== item.type ? item.slice(0, item.size, contentType) : item;
        if (typeof File !== 'undefined' && item instanceof File) form{% if genType === "ts" %}!{% endif %}.append(key, part, item.name);
        else form{% if genType === "ts" %}!{% endif %}.append(key, part);
      } else if (definition.contentType || typeof item === 'object') {
        const contentType = partContentType(definition.contentType, typeof item === 'object' ? 'application/json' : 'text/plain');
        const text = /(?:\/|\+)json(?:\s*;|$)/i.test(contentType) ? JSON.stringify(item) : String(item);
        form{% if genType === "ts" %}!{% endif %}.append(key, new Blob([text], { type: contentType }));
      } else {
        form{% if genType === "ts" %}!{% endif %}.append(key, String(item));
      }
    };
    if (Array.isArray(value)) {
      value.forEach((item) => append(name, item));
    } else {
      append(name, value);
    }
  }
  return multipart ? form : fields.join('&');
}
