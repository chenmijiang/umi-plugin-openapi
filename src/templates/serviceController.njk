{{ requestImportStatement }}

{% for api in list -%}
/** {{ api.desc if api.desc else '此处后端没有提供注释' }} {{api.method | upper}} {{ api.pathInComment | safe }} */
export async function {{ api.functionName }}(
{%- if api.params and api.hasParams %}
  params
  {%- if genType === "ts" -%}
  : {{namespace}}.{{api.typeName}}
  {%- endif -%}
  {{ "," if api.body }}
{%- endif -%}
{%- if api.body -%}
  body
  {{- "?" if not api.body.required -}}
  {%- if genType === "ts" -%}
  : {% if api.body.propertiesList %}{
    {%- for prop in api.body.propertiesList %}
    {% if prop.schema.description -%}
    /** {{ prop.schema.description }} */
    {% endif -%}
    {{ prop.key | safe }}{{ "?" if not prop.schema.required }}: {{ prop.schema.type }},
    {%- endfor %}
  }
  {%- else -%}
  {{ api.body.type }}
  {%- endif -%}
  {%- endif -%}
{%- endif %}
{{ "," if api.body or api.hasParams }}
  options {{ ("?: " + requestOptionsType) if genType === "ts" }}
) {
  {% for param in api.params.path -%}
  const {{ param.alias }} = params[{{ (param.inputName or param.name) | dump | safe }}];
  {% endfor -%}
  {% if api.params.cookie -%}
  const cookies = [
    {% for cookie in api.params.cookie -%}
    params[{{ (cookie.inputName or cookie.name) | dump | safe }}] == null ? '' : {{ (cookie.name + '=') | dump | safe }} + params[{{ (cookie.inputName or cookie.name) | dump | safe }}],
    {% endfor -%}
  ].filter(Boolean).join('; ');
  {% endif -%}

  return request{{ ("<" + api.response.type + ">") | safe if genType === "ts" }}({{ api.pathExpression | safe }}, {
    method: '{{ api.method | upper }}',
    {%- if api.response.responseType %}
    responseType: '{{ api.response.responseType }}',
    {%- endif %}
    {%- if api.hasHeader or api.params.cookie %}
    headers: {
      {%- if api.body.mediaType and api.body.mediaType !== "multipart/form-data" %}
      'Content-Type': {{ api.body.mediaType | dump | safe }},
      {%- endif %}
      {%- for header in api.params.header %}
      [{{ header.name | dump | safe }}]: params[{{ (header.inputName or header.name) | dump | safe }}],
      {%- endfor %}
      {%- if api.params.cookie %}
      ...(cookies ? { Cookie: cookies } : {}),
      {%- endif %}
    },
    {%- endif %}
    {%- if api.params.query %}
    params: {
      {%- for query in api.params.query %}
      [{{ query.name | dump | safe }}]: {% if query.schema.default is defined %}Object.prototype.hasOwnProperty.call(params, {{ (query.inputName or query.name) | dump | safe }}) ? params[{{ (query.inputName or query.name) | dump | safe }}] : {{ query.schema.default | dump | safe }}{% else %}params[{{ (query.inputName or query.name) | dump | safe }}]{% endif %},
      {%- endfor %}
    },
    {%- endif %}
    {%- if api.body %}
    data: body,
    {%- endif %}
    ...(options || {{api.options | dump}}),
  });
}

{% endfor -%}
