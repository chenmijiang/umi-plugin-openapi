{{ "," if api.body or api.hasParams or api.file }}
  options {{ ("?: " + requestOptionsType) if genType === "ts" }}
) {
  {% if api.hasParams -%}
  const parameterDefinitions{% if genType === "ts" %}: OpenAPIParameter[]{% endif %} = {{ api.parameterDefinitions | dump | safe }};
  const parameterValues{% if genType === "ts" %}: Record<string, unknown>{% endif %} = Object.assign(Object.create(null), {
