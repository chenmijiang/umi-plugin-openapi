{
  "name": "umi-plugin-openapi",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/chenmijiang/umi-plugin-openapi#readme",
  "bugs": {
    "url": "https://github.com/chenmijiang/umi-plugin-openapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmijiang/umi-plugin-openapi.git"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.cjs",
    "./core": "./dist/core.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "npm run build",
    "test": "vitest run",
    "oxfmt": "oxfmt",
    "oxlint": "oxlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@umijs/openapi": "^1.14.1",
    "rimraf": "^6.1.3",
    "serve-static": "^2.2.1",
    "swagger-ui-dist": "^5.34.0",
    "umi": "^4.7.28"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/serve-static": "^2.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{json,jsonc,json5,md,mdx,yaml,yml,html,css,scss,less}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ]
  }
}
