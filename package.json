{
  "name": "umi-plugin-openapi",
  "version": "0.0.2-beta.0",
  "description": "Umi plugin with a local OpenAPI service and mock generator",
  "keywords": [],
  "homepage": "https://github.com/chenmijiang/umi-plugin-openapi#readme",
  "bugs": {
    "url": "https://github.com/chenmijiang/umi-plugin-openapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmijiang/umi-plugin-openapi.git"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.cjs",
    "./core": "./dist/core.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "pretest": "npm run build",
    "test": "vitest run",
    "oxfmt": "oxfmt",
    "oxlint": "oxlint",
    "release": "release-it",
    "prepare": "husky"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "mockjs": "^1.1.0",
    "number-to-words": "^1.2.5",
    "nunjucks": "^3.2.4",
    "openapi3-ts": "^4.6.2",
    "prettier": "^2.8.8",
    "serve-static": "^2.2.1",
    "swagger-ui-dist": "^5.34.0",
    "swagger2openapi": "^7.0.8"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.6.5",
    "@types/number-to-words": "^1.2.3",
    "@types/nunjucks": "^3.2.6",
    "@types/serve-static": "^2.2.0",
    "@types/swagger2openapi": "^7.0.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "umi": "^4.7.28",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "umi": "^4.0.57"
  },
  "lint-staged": {
    "*.{json,jsonc,json5,md,mdx,yaml,yml,html,css,scss,less}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
